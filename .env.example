APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis (not "database"): FinanceReportService uses Cache::tags() for per-clinic report
# invalidation, which only Redis/Memcached-backed stores support (DatabaseStore has no
# tags() — Cache::tags() throws BadMethodCallException on it). Redis is already required
# for Horizon, so this adds no new infra dependency.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3 API). Health data has to stay inside Turkey, so production points at a
# Turkish S3-compatible provider through AWS_ENDPOINT, not at AWS itself. AWS_DEFAULT_REGION is
# then whatever zone name that provider uses; most of them also need path-style addressing.
# AWS_URL is only for disks that hand out public URLs (clinic logos) — media_private never does.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=tr-ist-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Treatment photos/documents (config/filesystems.php → media_private). 'local' in dev; production
# sets 's3' so medical media lands on the same Turkish storage. Never served by URL either way.
MEDIA_PRIVATE_DISK_DRIVER=local
# MEDIA_PRIVATE_S3_ROOT=media

# Backups carry the whole database, so production must write them off-site (BACKUP_DESTINATION_DISK=s3)
# and must set an archive password — an unencrypted backup on object storage is a patient-data leak.
BACKUP_DESTINATION_DISK=local
BACKUP_ARCHIVE_PASSWORD=

# SMS (config/services.php → services.sms). Provider: 'netgsm' (prod) |
# 'log' (local — writes the body to storage/logs/sms.log) | 'null' (silent, default/test).
# SMS sends run on the queue, so a worker (horizon / queue:work) must be processing the `sms` queue.
SMS_PROVIDER=null
PLATFORM_SMS_MONTHLY_QUOTA=1000
NETGSM_BASE_URL=https://api.netgsm.com.tr
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# HEIC/HEIF/WEBP treatment-photo conversions require imagick (gd cannot decode HEIC).
IMAGE_DRIVER=imagick

# spatie/laravel-pdf (Browsershot/Puppeteer driver). Local/testing already default to DDEV's
# baked Playwright Chromium (config/laravel-pdf.php) — no local setup needed. Production has
# no Chromium/Node of its own yet (flagged ops task); set these there when it's provisioned.
# LARAVEL_PDF_CHROME_PATH=
# LARAVEL_PDF_NODE_BINARY=
# LARAVEL_PDF_NPM_BINARY=

VITE_APP_NAME="${APP_NAME}"
